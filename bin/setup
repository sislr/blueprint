#!/usr/bin/env bash
# One-time setup: gets Node if needed, installs and builds Blueprint, checks Claude access and puts the
# `blueprint` command on your PATH. Safe to run again at any time.
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT="$PWD"

step() { printf '\n\033[1;34m▸ %s\033[0m\n' "$1"; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$1"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$1" >&2; exit 1; }
# ask "question": yes by default; without a terminal (e.g. CI) the answer is yes.
ask() {
  [ -t 0 ] || return 0
  local reply
  read -r -p "$1 [Y/n] " reply
  [[ -z "$reply" || "$reply" =~ ^[Yy] ]]
}

step "Checking Node.js"
node_ok() { command -v node >/dev/null && [ "$(node -p 'process.versions.node.split(".")[0]')" -ge 22 ]; }
if ! node_ok; then
  have=$(command -v node >/dev/null && node -v || echo "none")
  if command -v brew >/dev/null && ask "Blueprint needs Node.js 22 or newer (found: $have). Install it with Homebrew?"; then
    if brew list node >/dev/null 2>&1; then brew upgrade node; else brew install node; fi
    hash -r
  fi
  node_ok || fail "Node.js 22 or newer is required (found: $(command -v node >/dev/null && node -v || echo none)). Get it from https://nodejs.org"
fi
echo "node $(node -v)"

step "Installing and building"
npm install --no-fund --no-audit --loglevel=error
npm run build --silent -- --logLevel warn

step "Checking Claude access"
if [ -n "${ANTHROPIC_API_KEY:-}" ] || grep -qs '^ANTHROPIC_API_KEY=.\+' .env; then
  echo "Using ANTHROPIC_API_KEY"
elif [ -n "${CLAUDE_CODE_USE_BEDROCK:-}${CLAUDE_CODE_USE_VERTEX:-}${CLAUDE_CODE_USE_FOUNDRY:-}" ]; then
  echo "Using your cloud provider settings"
elif command -v claude >/dev/null || [ -d "$HOME/.claude" ]; then
  echo "No API key set, so the agent uses your Claude Code login"
else
  [ -f .env ] || cp .env.example .env
  warn "No API key yet. Blueprint runs the agent on the Claude API:"
  echo "  • create a key at https://platform.claude.com/settings/keys"
  echo "  • put it in $ROOT/.env as ANTHROPIC_API_KEY=..."
fi

step "Installing the blueprint command"
# A plain symlink in a folder that's already on PATH. Unlike `npm link`, it keeps working when you switch
# Node versions (mise, nvm, fnm, ...).
# An older setup used `npm link`; that copy would shadow the new one.
npm unlink -g blueprint >/dev/null 2>&1 || true
target="$ROOT/bin/blueprint.js"
on_path() { case ":$PATH:" in *":$1:"*) return 0 ;; *) return 1 ;; esac; }
installed=""
for dir in "$HOME/.local/bin" "$HOME/bin" /opt/homebrew/bin /usr/local/bin; do
  if on_path "$dir" && [ -d "$dir" ] && [ -w "$dir" ]; then
    if ln -sf "$target" "$dir/blueprint" 2>/dev/null; then
      installed="$dir/blueprint"
      break
    fi
  fi
done
if [ -z "$installed" ]; then
  # Nothing suitable on PATH. Put it in ~/.local/bin and tell the user how to add that folder;
  # setup never edits shell startup files.
  mkdir -p "$HOME/.local/bin"
  ln -sf "$target" "$HOME/.local/bin/blueprint" || fail "Couldn't create $HOME/.local/bin/blueprint. Run $target directly instead."
  installed="$HOME/.local/bin/blueprint"
  warn "$HOME/.local/bin isn't on your PATH. Add this line to your shell's startup file (e.g. ~/.zshrc):"
  echo '    export PATH="$HOME/.local/bin:$PATH"'
  echo "  Until then, run $installed directly."
fi
hash -r
echo "blueprint → $installed"

printf '\n\033[1;32m✓ Ready.\033[0m In any project folder, run:\n\n    blueprint\n\n'
printf 'To update later: blueprint update\n'
